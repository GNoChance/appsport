{
  "name": "appsport",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @appsport/web test:e2e",
    "build": "pnpm --filter @appsport/web build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/node": "^24.7",
    "typescript": "^7",
    "vitest": "^5"
  }
}
