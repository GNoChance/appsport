#!/usr/bin/env bash
# appsport-unlock (R-OPS-6, R-DEP-6) : après un redémarrage, via Tailscale SSH : sudo appsport-unlock.
# Idempotent : ouvre le volume LUKS si besoin, le monte, démarre Docker et appsport, attend /api/health
# (2 min au plus), affiche OK ou KO, pingue alive et relance la sauvegarde de la nuit, puis le test de restauration
# du mois, s'ils ont été manqués.
# Codes : 0 OK, 1 KO.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/common.sh"

luks_open() { "$CRYPTSETUP" status "$LUKS_NAME" >/dev/null 2>&1; }

# KO affiché d'abord (R-OPS-6 étape 5), puis signalé à Healthchecks (alive/fail, motif joint) : un
# Healthchecks injoignable (curl -m 10 --retry 3) ne retarde pas le message. Code 1.
ko() {
  printf 'KO : %s\n' "$1" >&2
  hc_ping alive fail "$2" || true
  exit 1
}

# Dernière sauvegarde réussie absente de status.json ou de plus de 24 h (machine éteinte ou verrouillée à 03:30,
# ou sauvegarde en échec : son at récent ne compte pas).
backup_missed() {
  local at at_s
  at=$("$JQ" -r '(.backup | select(.ok == true) | .at) // ""' "$APPSPORT_ROOT/data/ops/status.json" 2>/dev/null) ||
    return 0
  [ -n "$at" ] || return 0
  at_s=$(date -u -d "$at" +%s 2>/dev/null) || return 0
  [ $(($(date -u +%s) - at_s)) -gt 86400 ]
}

# Dernier créneau passé du timer appsport-restore-test (Sun *-*-01..07 05:00:00, heure locale), en secondes.
last_restore_test_slot() {
  local now i month dow slot
  now=$(date +%s)
  for i in 0 1; do
    month=$(date -d "$(date +%Y-%m-15) -$i month" +%Y-%m) || return 1
    dow=$(date -d "$month-01" +%u) || return 1
    slot=$(date -d "$month-0$((1 + (7 - dow) % 7)) 05:00:00" +%s) || return 1
    if [ "$slot" -le "$now" ]; then
      printf '%s\n' "$slot"
      return 0
    fi
  done
  return 1
}

# Test de restauration absent de status.json ou antérieur au dernier créneau : le timer a tourné volume verrouillé
# (Persistent=true au démarrage après une coupure), sans rien écrire, et ne repasserait que le mois suivant.
restore_test_missed() {
  local slot at at_s
  slot=$(last_restore_test_slot) || return 1
  at=$("$JQ" -r '.restoreTest.at // ""' "$APPSPORT_ROOT/data/ops/status.json" 2>/dev/null) || return 0
  [ -n "$at" ] || return 0
  at_s=$(date -u -d "$at" +%s 2>/dev/null) || return 0
  [ "$at_s" -lt "$slot" ]
}

main() {
  require_cmds "$JQ" "$CURL" "$CRYPTSETUP"
  if ! luks_open; then
    "$CRYPTSETUP" open "$LUKS_DEVICE" "$LUKS_NAME" || die "Phrase refusée."
  fi
  if ! volume_mounted; then
    "$MOUNT" "$APPSPORT_ROOT" || ko "montage de $APPSPORT_ROOT impossible." "montage impossible"
  fi
  sentinel_present || ko "sentinelle absente, ce n'est pas le volume appsport." "sentinelle absente"
  "$SYSTEMCTL" start docker || ko "Docker ne démarre pas (voir P8)." "docker ne demarre pas"
  # Base restaurée sans privacy:reapply : ne pas la servir (03 §8) ; Docker reste démarré pour P4.
  if reapply_pending; then
    ko "réapplication des suppressions en attente : suivez P4." "reapplication en attente"
  fi
  compose up -d || ko "docker compose up -d a échoué (voir P8)." "compose up en echec"
  # shellcheck disable=SC2119 # sans version : toute version saine convient
  wait_health || ko "/api/health ne répond pas 200 après 2 min (voir P8)." "api/health ne repond pas 200"
  log "OK : appsport répond (version $HEALTH_VERSION)."
  hc_ping alive || log "Avertissement : ping alive non reçu par Healthchecks."
  if backup_missed; then
    log "Sauvegarde de la nuit manquée : relance de appsport-backup."
    "$SYSTEMCTL" start --no-block appsport-backup.service || log "Avertissement : relance de appsport-backup impossible."
  fi
  # Après la sauvegarde éventuelle : After=appsport-backup.service attend sa fin (verrou exclusif).
  if restore_test_missed; then
    log "Test de restauration du mois manqué : relance de appsport-restore-test."
    "$SYSTEMCTL" start --no-block appsport-restore-test.service ||
      log "Avertissement : relance de appsport-restore-test impossible."
  fi
  return 0
}

main "$@"; exit $?
