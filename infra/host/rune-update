#!/usr/bin/env bash
# rune-update (R-DEP-3, R-DEP-4, 08 §8) : sudo rune-update vX.Y.Z [--yes] | sudo rune-update --rollback [--yes]
# Déploie une version taguée ; en cas d'échec, revient à la précédente : image seule d'abord (ni restauration
# ni nouvelle époque), restauration de l'instantané pre-vX.Y.Z seulement si l'image précédente reste KO.
# Codes : 0 succès, 1 échec ou abandon, 2 usage.
# Le git checkout remplace ce fichier en cours d'exécution : tout est en fonctions, lues avant la dernière ligne.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/common.sh"

MODE=""
NEW=""
YES=0

usage() {
  printf '%s\n' "Usage : rune-update vX.Y.Z [--yes]" "        rune-update --rollback [--yes]" >&2
  exit 2
}

parse_args() {
  local arg
  for arg in "$@"; do
    case $arg in
      --yes) YES=1 ;;
      --rollback) MODE=rollback ;;
      *)
        if [ -z "$NEW" ] && valid_version "$arg"; then NEW=$arg; else usage; fi
        ;;
    esac
  done
  if [ "$MODE" = rollback ]; then
    [ -z "$NEW" ] || usage
  else
    [ -n "$NEW" ] || usage
    MODE=deploy
  fi
}

# --yes saute la question ; toute autre réponse que o ou oui abandonne sans rien changer.
confirm() {
  local answer=""
  if [ "$YES" = 1 ]; then return 0; fi
  printf '%s [o/N] ' "$1"
  read -r answer || answer=""
  case $answer in
    o | O | oui | Oui | OUI) return 0 ;;
  esac
  echo
  die "Abandon : rien n'a été changé."
}

show_active_sessions() {
  local out user started n=0
  out=$(app_cli sessions:active --hours 3) ||
    die "Impossible de lister les séances en cours. Rien n'a été changé."
  while IFS=$'\t' read -r user started; do
    [ -n "$user" ] || continue
    if [ "$n" -eq 0 ]; then log "Séances en cours depuis moins de 3 h :"; fi
    log "- $user (début $started)"
    n=$((n + 1))
  done <<<"$out"
  if [ "$n" -eq 0 ]; then log "Aucune séance en cours depuis moins de 3 h."; fi
}

# shellcheck disable=SC2016 # variables du filtre jq, pas du shell
deploy_json() {
  "$JQ" -cn --arg at "$(now_iso)" --arg v "$1" --arg p "$2" --argjson ok "$3" \
    '{at: $at, version: $v, previousVersion: $p, ok: $ok}'
}

# Retour du dépôt au tag en place après un échec de pull ou de sauvegarde (rien d'autre n'a changé).
checkout_back() {
  "$GIT" -C "$RUNE_REPO" checkout --quiet "$1" ||
    log "Attention : le dépôt $RUNE_REPO n'a pas pu revenir au tag $1 (git checkout $1 à refaire)."
}

# deploy.log illisible ou disque plein : avertissement, le message d'échec ou de succès s'affiche quand même.
record_deploy() {
  log_deploy "$@" || log "Avertissement : deploy.log non écrit."
}

# Section deploy de status.json (page santé) ; même règle que record_deploy si elle ne s'écrit pas.
record_status() {
  status_merge deploy "$1" || log "Avertissement : status.json non mis à jour."
}

# Pull ou sauvegarde pre-deploy en échec (T43-F14) : dépôt ramené au tag en place, résultat dans deploy.log,
# et la page santé le montre : deploy {version en place, inchangée, ok false}.
not_deployed() {
  checkout_back "$1"
  record_deploy "$1" "$NEW" "$2"
  record_status "$(deploy_json "$1" "$1" false)"
}

main() {
  local line prev cur lock=0
  parse_args "$@"
  require_cmds "$JQ" "$FLOCK" "$GIT" "$RESTIC" "$CURL"
  take_lock || lock=$?
  case $lock in
    0) ;;
    2) die "Impossible d'ouvrir $LOCK_FILE : lancez avec sudo." ;;
    *) die "Une autre opération Rune est en cours. Rien n'a été changé." ;;
  esac
  volume_mounted || die "Volume non monté : lancez d'abord sudo rune-unlock. Rien n'a été changé."
  sentinel_present || die "Sentinelle $RUNE_ROOT/data/.rune-volume absente. Rien n'a été changé."
  ! reapply_pending || die "Réapplication des suppressions en attente : suivez P4."
  if [ "$MODE" = rollback ]; then
    if ! line=$(grep ' ok$' "$RUNE_ROOT/deploy.log" | tail -n1) || [ -z "$line" ]; then
      die "Aucun déploiement réussi à annuler."
    fi
    read -r _ prev cur _ <<<"$line"
    if ! valid_version "$prev" || ! valid_version "$cur"; then
      die "Dernier déploiement réussi illisible dans $RUNE_ROOT/deploy.log. Rien n'a été changé."
    fi
    [ "$(current_version)" = "$cur" ] || die "La version en place n'est pas $cur."
    confirm "Revenir de $cur à $prev ?"
    trap '' HUP
    rollback "$prev" "$cur" manual
    return $?
  fi
  health_json >/dev/null || die "L'appli ne répond pas 200 sur /api/health : voir P8. Rien n'a été changé."
  if ! prev=$(current_version) || ! valid_version "$prev"; then
    die "Version en place illisible dans $RUNE_ROOT/deploy.env. Rien n'a été changé."
  fi
  [ "$NEW" != "$prev" ] || die "$NEW est déjà déployée."
  show_active_sessions
  confirm "Déployer $NEW (version actuelle $prev) ?"
  trap '' HUP
  trap 'interrupted_early "$prev"' INT TERM
  "$GIT" -C "$RUNE_REPO" fetch --tags || die "git fetch impossible. Rien n'a été changé."
  "$GIT" -C "$RUNE_REPO" checkout --quiet "$NEW" || die "Tag $NEW introuvable. Rien n'a été changé."
  if ! RUNE_VERSION="$NEW" compose pull app; then
    not_deployed "$prev" pull-failed
    die "Échec du téléchargement de l'image $NEW (jeton GHCR expiré ? voir P5). Rien n'a été changé."
  fi
  if ! app_cli snapshot --tag "pre-$NEW" || ! restic_backup_all pre-deploy; then
    not_deployed "$prev" backup-failed
    die "Échec de l'instantané ou de la sauvegarde pre-deploy. Le service n'a pas été modifié."
  fi
  # Étape 5 (R-DEP-3) : à partir d'ici, tout échec passe par le retour arrière, qui ramène le dépôt et consigne.
  RB_TARGET=$prev RB_FROM=$NEW RB_KIND=auto
  trap interrupted INT TERM
  if ! write_deploy_env "$NEW"; then
    log "deploy.env non écrit : retour arrière automatique."
    rollback "$prev" "$NEW" auto
    return 1
  fi
  if compose up -d && wait_health "$NEW"; then
    trap - INT TERM
    record_deploy "$prev" "$NEW" ok
    record_status "$(deploy_json "$NEW" "$prev" true)"
    log "Déploiement de $NEW réussi."
    return 0
  fi
  log "Échec du démarrage de $NEW : retour arrière automatique."
  rollback "$prev" "$NEW" auto
  return 1
}

# Résultat du retour arrière dans deploy.log et dans la section deploy de status.json.
#   auto   : ligne « <précédente> <demandée> <résultat> », deploy {version: demandée, ok: false} ;
#   manual : ligne « <en place> <cible> <résultat> », deploy {version: cible, ok: résultat ≠ rollback-failed}.
finish() {
  local result=$1 ok=true
  if [ "$RB_KIND" = auto ]; then
    record_deploy "$RB_TARGET" "$RB_FROM" "$result"
    record_status "$(deploy_json "$RB_FROM" "$RB_TARGET" false)"
  else
    if [ "$result" = rollback-failed ]; then ok=false; fi
    record_deploy "$RB_FROM" "$RB_TARGET" "$result"
    record_status "$(deploy_json "$RB_TARGET" "$RB_FROM" "$ok")"
  fi
}

# Après la confirmation, SSH coupé (HUP, hérité ignoré par docker, curl…) : l'opération va à son terme et
# consigne son résultat. Ctrl-C ou TERM : le script s'arrête dès la commande en cours finie.
# Avant deploy.env : le service n'a pas changé, le dépôt revient au tag en place.
# shellcheck disable=SC2317 # appelée par trap
interrupted_early() {
  trap - INT TERM
  checkout_back "$1"
  die "Interrompu : le service n'a pas été modifié."
}

# Dès deploy.env : consigné rollback-failed (sinon --rollback refuserait une version en place non consignée).
# shellcheck disable=SC2317 # appelée par trap
interrupted() {
  trap - INT TERM
  finish rollback-failed
  die "Interrompu : suivez P4."
}

# rollback <cible> <abandonnée> <auto|manual> (R-DEP-4).
rollback() {
  local snap mtime since stamp list
  RB_TARGET=$1 RB_FROM=$2 RB_KIND=$3
  trap interrupted INT TERM
  # Chaque échec est consigné (finish) avant le message : rien ne repose sur set -e ici.
  ko() {
    trap - INT TERM
    finish rollback-failed
    die "$1 : suivez P4."
  }
  # deploy.env déjà sur la cible (son écriture pour $2 a échoué) : rien à réécrire.
  write_deploy_env "$1" || [ "$(current_version)" = "$1" ] || ko "deploy.env non écrit"
  "$GIT" -C "$RUNE_REPO" checkout --quiet "$1" || ko "Tag $1 introuvable"
  # Image seule : ni restauration ni nouvelle époque (R-VER-7 accepte un schéma plus récent non cassant).
  if compose up -d && wait_health "$1"; then
    trap - INT TERM
    finish rolled-back-image
    log "Retour à $1 (image seule, sans restauration)."
    return 0
  fi
  log "L'image $1 ne démarre pas sur ce schéma : restauration de l'instantané pre-$2."
  snap="$RUNE_ROOT/data/snapshots/pre-$2.db"
  [ -f "$snap" ] || ko "Instantané pre-$2 introuvable"
  mtime=$(stat -c %Y "$snap") || ko "Date de l'instantané pre-$2 illisible"
  since=$(date -u -d "@$((mtime - 300))" +%Y-%m-%dT%H:%M:%SZ) || ko "Date de l'instantané pre-$2 illisible"
  stamp=$(date -u +%Y%m%dT%H%M%SZ) || ko "Horodatage de la liste privacy impossible"
  list="ops/privacy-$2-$stamp.json"
  ensure_ops_dir || ko "data/ops inaccessible"
  # T24 : lecture seule de la base courante, sans migration ni --source.
  app_cli_run privacy:collect --since "$since" --out "/data/$list" || ko "privacy:collect impossible"
  compose stop app || ko "Arrêt de app impossible"
  # Avant restore : jusqu'à la réapplication, unlock et update refusent de relancer app (03 §8).
  printf '%s\n' "/data/$list" >"$REAPPLY_MARKER" || ko "Marqueur $REAPPLY_MARKER non écrit"
  { app_cli_run restore "/data/snapshots/pre-$2.db" && app_cli_run privacy:reapply "/data/$list"; } ||
    ko "Restauration ou réapplication impossible"
  # Liste purgée après réapplication (03 §7), dans data/ops épinglé ; un échec n'interrompt pas le retour arrière.
  in_ops_dir rm -f "${list#ops/}" ||
    log "Avertissement : liste $RUNE_ROOT/data/$list non supprimée (données personnelles) : supprimez-la à la main."
  # Réapplication faite : le marqueur (hors data/, à root) est levé, sinon unlock et update refuseraient de relancer app.
  rm -f "$REAPPLY_MARKER" || ko "Marqueur $REAPPLY_MARKER non supprimé"
  { compose up -d && wait_health "$1"; } || ko "L'image $1 ne répond pas après restauration"
  trap - INT TERM
  finish rolled-back-restore
  log "Base restaurée : les téléphones renverront leurs 60 derniers jours."
}

main "$@"; exit $?
