#!/usr/bin/env bash
# rune-restore-test (R-OPS-11, R-DEP-7, 08 §7) : timer du 1er dimanche du mois à 05:00.
# 1. restaure le dernier daily hors site dans $RUNE_ROOT/tmp/restore-test-<AAAAMMJJTHHMMSSZ>/ (volume chiffré,
#    jamais le disque en clair) ; 2. db:stats sur une copie du plus récent (intégrité, au moins un utilisateur) dans
#    un conteneur sans réseau ; 3. base réelle intègre, retard de la copie sur elle de 48 h au plus ; 4. conteneur
#    jetable de la même image, sans réseau ni secret, qui doit répondre 200 sur /api/health ; 5. restic check
#    --read-data-subset=5% local puis offsite ; 6. détruit tout, écrit restoreTest dans status.json, pingue.
# Codes : 0 succès, 1 échec (signalé par /fail, motif sans donnée personnelle).
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/common.sh"

CONTAINER=rune-restore-test
MAX_LAG_S=172800
# Base réelle en deçà de la copie : impossible sans restauration (horodatages de l'horloge du serveur), sauf horloge
# recalée de quelques minutes.
MAX_AHEAD_S=300
# Même sonde que l'image (node:24-slim n'a pas curl), bornée à 5 s par essai.
HEALTH_PROBE="fetch('http://127.0.0.1:3000/api/health',{signal:AbortSignal.timeout(5000)}).then(r=>process.exit(r.status===200?0:1),()=>process.exit(1))"
RT_DIR=""
CONTAINER_STARTED=0
DETAIL=""

remove_container() {
  if [ "$CONTAINER_STARTED" = 1 ]; then
    "$DOCKER" rm -f "$CONTAINER" >/dev/null 2>&1 || log "Avertissement : conteneur $CONTAINER non supprimé."
    CONTAINER_STARTED=0
  fi
}

# Conteneur puis copie : rien ne reste (trap EXIT, et avant tout résultat).
cleanup() {
  remove_container
  if [ -n "$RT_DIR" ]; then
    rm -rf -- "$RT_DIR" || log "Avertissement : $RT_DIR non supprimé."
    RT_DIR=""
  fi
}

# fail <motif> : nettoyage, section restoreTest de status.json (volume monté seulement), /fail, code 1.
# Un second signal pendant fail ne fait que sortir (le trap EXIT nettoie) : le premier motif reste.
fail() {
  trap 'exit 1' INT TERM HUP
  cleanup
  log "Échec du test de restauration : $1"
  if volume_ready; then
    status_merge restoreTest "$(ops_check_json false "$1")" || log "Avertissement : status.json non mis à jour."
  fi
  hc_ping restore-test fail "$1" || log "Avertissement : échec non signalé à Healthchecks."
  exit 1
}

# latest_daily <dossier> : daily-AAAAMMJJ.db le plus récent (fichier ordinaire, jamais un lien).
latest_daily() {
  local f last=""
  for f in "$1"/daily-*.db; do
    if [ -f "$f" ] && [ ! -L "$f" ]; then last=$f; fi
  done
  [ -n "$last" ] && printf '%s\n' "$last"
}

# json_field <json> <champ> : valeur du champ, vide si absent ou illisible.
# shellcheck disable=SC2016 # variables du filtre jq, pas du shell
json_field() { "$JQ" -r --arg k "$2" '.[$k] // empty' <<<"$1" 2>/dev/null || true; }

# lag_seconds <db:stats copie> <db:stats réelle> : avance de la base réelle en secondes (négative si elle recule).
# shellcheck disable=SC2016 # variables du filtre jq, pas du shell
lag_seconds() {
  "$JQ" -nr --argjson c "$1" --argjson l "$2" \
    'def t: sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601;
     ($l.lastWriteAt | t) - ($c.lastWriteAt | t) | floor' 2>/dev/null
}

# Test du daily restauré : intégrité, utilisateurs, retard ; détail « <fichier> ; écart <h> h » dans DETAIL.
check_copy() {
  local daily=$1 image=$2 copy live users lag
  copy=$("$DOCKER" run --rm --network none --read-only --user 1000 --pull never -v "$RT_DIR/data:/data" \
    "$image" node /app/server.mjs db:stats) || fail "db:stats impossible sur la copie restaurée"
  [ "$(json_field "$copy" integrity)" = ok ] || fail "intégrité KO sur la copie restaurée"
  users=$(json_field "$copy" users)
  if ! [[ "$users" =~ ^[0-9]+$ ]] || [ "$users" -lt 1 ]; then fail "aucun utilisateur dans la copie restaurée"; fi
  live=$(app_cli db:stats) || fail "db:stats impossible sur la base réelle"
  [ "$(json_field "$live" integrity)" = ok ] || fail "intégrité KO sur la base réelle"
  lag=$(lag_seconds "$copy" "$live") || lag=""
  [[ "$lag" =~ ^-?[0-9]+$ ]] || fail "date de dernière écriture illisible"
  [ "$lag" -ge "-$MAX_AHEAD_S" ] || fail "base réelle plus ancienne que la sauvegarde"
  if [ "$lag" -lt 0 ]; then lag=0; fi
  [ "$lag" -le "$MAX_LAG_S" ] || fail "retard de $((lag / 3600)) h sur la base réelle"
  DETAIL="${daily##*/} ; écart $((lag / 3600)) h"
}

# Conteneur jetable de la même image : sans réseau, racine en lecture seule, sans app.env ; 200 attendu sur
# /api/health dans le délai de santé (HEALTH_TIMEOUT_S), puis supprimé.
check_container() {
  local image=$1 tries i
  CONTAINER_STARTED=1
  "$DOCKER" run -d --name "$CONTAINER" --network none --read-only --tmpfs /tmp --user 1000 --pull never \
    -v "$RT_DIR/data:/data" -e APP_ORIGIN=https://restore-test.invalid "$image" >/dev/null ||
    fail "conteneur jetable impossible à démarrer"
  tries=$((HEALTH_TIMEOUT_S / HEALTH_POLL_S))
  if [ "$tries" -lt 1 ]; then tries=1; fi
  for ((i = 1; i <= tries; i++)); do
    if "$DOCKER" exec "$CONTAINER" node -e "$HEALTH_PROBE" >/dev/null 2>&1; then
      remove_container
      return 0
    fi
    if [ "$i" -lt "$tries" ]; then "$SLEEP" "$HEALTH_POLL_S"; fi
  done
  fail "conteneur jetable : api/health sans 200"
}

main() {
  local version image daily where
  local -a problems=()
  require_cmds "$JQ" "$FLOCK" "$RESTIC" "$CURL"
  hc_ping restore-test start || log "Avertissement : début non signalé à Healthchecks."
  volume_ready || fail "volume verrouillé : lancer rune-unlock"
  take_lock || fail "verrou occupé"
  trap cleanup EXIT
  trap 'fail "test de restauration interrompu"' INT TERM HUP
  if ! version=$(current_version) || ! valid_version "$version"; then
    fail "version en place illisible dans deploy.env"
  fi
  image="ghcr.io/gnochance/rune:$version"

  # Conteneur et copies d'un test interrompu (coupure) : supprimés avant tout (rune-backup le fait aussi
  # chaque nuit).
  if ! (umask 077 && mkdir -p "$RUNE_ROOT/tmp") || ! purge_restore_test_leftovers; then
    fail "dossier tmp du volume inutilisable"
  fi
  RT_DIR="$RUNE_ROOT/tmp/restore-test-$(date -u +%Y%m%dT%H%M%SZ)"
  (umask 077 && mkdir "$RT_DIR") || fail "copie de test impossible à créer"

  restic_on offsite restore latest --tag daily --target "$RT_DIR" --include "$RUNE_ROOT/data/snapshots" >&2 ||
    fail "restauration offsite impossible"
  daily=$(latest_daily "$RT_DIR$RUNE_ROOT/data/snapshots") ||
    fail "aucun instantané daily dans la sauvegarde offsite"
  # Copie en data/rune.db avec sentinelle, au conteneur (utilisateur 1000) : WAL et migrations y écrivent.
  if ! (umask 077 && mkdir "$RT_DIR/data") || ! cp -- "$daily" "$RT_DIR/data/rune.db" ||
    ! : >"$RT_DIR/data/.rune-volume" || ! "$CHOWN" -R 1000:1000 "$RT_DIR/data"; then
    fail "copie de test impossible à préparer"
  fi

  check_copy "$daily" "$image"
  check_container "$image"
  for where in local offsite; do
    restic_on "$where" check --read-data-subset=5% >&2 || problems+=("restic check $where en échec")
  done
  if [ "${#problems[@]}" -gt 0 ]; then fail "$(join_problems "${problems[@]}")"; fi

  cleanup
  status_merge restoreTest "$(ops_check_json true "$DETAIL")" || log "Avertissement : status.json non mis à jour."
  hc_ping restore-test || log "Avertissement : succès non signalé à Healthchecks."
  log "Test de restauration réussi : $DETAIL."
}

main "$@"; exit $?
