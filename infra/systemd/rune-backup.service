# Rune : instantané daily et sauvegardes restic local et offsite (08 §9, §15) ; /usr/local/sbin/rune-backup est un lien vers infra/host/.
[Unit]
Description=Rune : instantané daily et sauvegardes restic local et offsite
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rune-backup
# Oneshot : aucun délai par défaut ; au-delà, SIGTERM. Un lancement bloqué (restic sur B2) empêcherait les suivants.
TimeoutStartSec=4h
