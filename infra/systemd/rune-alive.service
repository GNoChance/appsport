# Rune : santé par l'URL *.ts.net, ping Healthchecks alive (08 §9, §15) ; /usr/local/sbin/rune-alive est un lien vers infra/host/.
[Unit]
Description=Rune : santé par l'URL *.ts.net, ping Healthchecks alive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rune-alive
# Oneshot : aucun délai par défaut ; au-delà, SIGTERM. Un lancement bloqué (restic sur B2) empêcherait les suivants.
TimeoutStartSec=2min
